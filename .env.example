# Multimodal AI Financial Assistant — environment template
#
# Copy to `.env` and fill in.  `.env` is gitignored and must NEVER be committed (Rule 4).
#     cp .env.example .env
#
# Every key below is FREE. If any provider ever asks for a credit card, that is a
# Rule 1 breach — stop and revisit architecture.md rather than paying.

# ── REQUIRED — Groq Cloud (vision + reasoning) ────────────────────────────────
# Free tier, no credit card. Sign up and create a key at:  https://console.groq.com/keys
# Rate-limited rather than metered — src/chain.py handles 429 with backoff (Phase 4).
GROQ_API_KEY=gsk_your_key_here

# ── OPTIONAL — LangSmith tracing ──────────────────────────────────────────────
# Free tier, 5,000 traces/month:  https://smith.langchain.com/
# The app MUST run normally with these unset (decision D-11). Leave blank to disable.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multimodal-fin-assistant

# ── REQUIRED — Hugging Face Inference API (embeddings) ────────────────────────
# Free, no credit card:  https://hf.co/settings/tokens  (a READ token is enough)
#
# Embeddings are computed by this endpoint rather than in-process. That is what removed
# torch and sentence-transformers, and it is what makes the app fit in 512 MB — but it
# also means chunk text is sent to HuggingFace, reversing the old guarantee that document
# text never left the machine at embed time (decision D-2).
#
# To keep embeddings local instead, run a Text Embeddings Inference server and point
# EMBEDDING_ENDPOINT_URL at it; the code path is identical.
HF_TOKEN=
# EMBEDDING_ENDPOINT_URL=

# ── REQUIRED WHEN DEPLOYED — browser origins allowed to call the API ──────────
# Comma-separated. The default below covers the local Next.js dev server, so local work
# needs nothing here. A deployed frontend is a different origin and the browser blocks it
# until it is listed:
#     ALLOWED_ORIGINS=https://finlens.vercel.app
# '*' is rejected at startup, not accepted: this API sends credentials, and a wildcard
# combined with credentials lets any site call it on a signed-in user's behalf.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── OPTIONAL — behavior overrides ─────────────────────────────────────────────
# Defaults live in src/config.py. Uncomment only to override.

# Below this Docling text-yield ratio, a page is treated as a scanned image and
# escalated to the vision model (FR-2.3). Raise it if vision fires too rarely.
# TEXT_YIELD_THRESHOLD=0.15

# Retrieval depth: k for the active document, and k for the policy corpus.
# RETRIEVAL_K_DOCUMENT=6
# RETRIEVAL_K_POLICY=4

# Cache Groq responses by prompt hash so repeated eval runs cost zero extra requests.
# LLM_CACHE_ENABLED=true

# DEBUG | INFO | WARNING | ERROR.  Financial data is never logged at any level (Rule 2.3).
# LOG_LEVEL=INFO
